{
  "name": "@zjinh/vue-virtual-tree",
  "description": "A virtual tree component for Vue 2.7 and Vue 3",
  "version": "1.0.3",
  "author": "zjinh",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/vue3/index.js",
  "module": "./dist/vue3/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3/index.js",
      "default": "./dist/vue3/index.js"
    },
    "./vue2": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue2/index.js",
      "default": "./dist/vue2/index.js"
    },
    "./vue3": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3/index.js",
      "default": "./dist/vue3/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "virtual",
    "tree",
    "bigdata",
    "largedata",
    "lazy loading",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjinh/vue-virtual-tree.git"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsdown && tsc -p tsconfig.declarations.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:sfc": "vue-tsc --noEmit -p tsconfig.sfc.json",
    "test": "pnpm run test:package && pnpm run test:model && pnpm run test:components && pnpm run typecheck && pnpm run typecheck:sfc && pnpm run build && pnpm run test:artifacts && pnpm run test:types",
    "test:package": "node --test tests/package-contract.test.mjs",
    "test:model": "vitest run tests/model",
    "test:component:vue2": "vitest run --config vitest.component.vue2.config.ts",
    "test:component:vue3": "vitest run --config vitest.component.vue3.config.ts",
    "test:components": "pnpm run test:component:vue2 && pnpm run test:component:vue3",
    "test:artifacts": "node --test tests/artifact-contract.test.mjs",
    "test:types": "tsc -p tests/types/vue3/tsconfig.json && tsc -p tests/types/vue2/tsconfig.json",
    "prepack": "pnpm run build && pnpm run test:artifacts",
    "prepublishOnly": "pnpm run release:check",
    "release:check": "pnpm run test:package && pnpm run test:model && pnpm run test:components && pnpm run typecheck && pnpm run typecheck:sfc && pnpm run build && pnpm run test:artifacts && pnpm run test:types && publint"
  },
  "peerDependencies": {
    "vue": "^2.7.0 || ^3.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "0.22.14",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue2": "2.3.4",
    "jsdom": "30.0.1",
    "less": "4.8.1",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "unplugin-vue": "7.2.0",
    "vite": "7.2.4",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.9",
    "vue2": "npm:vue@2.7.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.4"
}
